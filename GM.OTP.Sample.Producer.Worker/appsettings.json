{
  "ConnectionStrings": {
    "ApplicationDatabase": "Host=localhost;Port=5432;Database=GMOTPSample;Username=postgres;Password=123456"
  },
  "Messaging": {
    "ServiceName": "GM.OTP.Sample.Producer.Worker",
    "RabbitMq": {
      "HostName": "localhost",
      "Port": 5672,
      "VirtualHost": "/",
      "UserName": "guest",
      "Password": "guest"
    },
    "Retry": {
      "MaxAttempts": 5,
      "InitialDelayMilliseconds": 250
    },
    "CircuitBreaker": {
      "Enabled": true,
      "TrackingPeriodSeconds": 60,
      "PauseTimeSeconds": 30,
      "FailurePercentageThreshold": 25,
      "MinimumThreshold": 10
    },
    "OutboxRelay": {
      "BatchSize": 50,
      "MaxRetries": 5,
      "PollingIntervalSeconds": 5
    }
  },
  "ProducerTopology": {
    "Routes": [
      {
        "MessageType": "GM.OTP.Sample.Domain.Events.Otp.OtpGeneratedIntegrationEvent, GM.OTP.Sample.Domain",
        "Exchange": "gm.events",
        "RoutingKey": "otp.generated",
        "Kind": "Topic"
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
