{
  "ConnectionStrings": {
    "ApplicationDatabase": "Host=localhost;Port=5432;Database=GMOTPSample;Username=postgres;Password=123456"
  },
  "Messaging": {
    "ServiceName": "GM.OTP.Sample.Consumer.Worker",
    "RabbitMq": {
      "HostName": "localhost",
      "Port": 5672,
      "VirtualHost": "/",
      "UserName": "guest",
      "Password": "guest"
    },
    "Retry": {
      "MaxAttempts": 5,
      "InitialDelayMilliseconds": 250
    },
    "CircuitBreaker": {
      "Enabled": true,
      "TrackingPeriodSeconds": 60,
      "PauseTimeSeconds": 30,
      "FailurePercentageThreshold": 25,
      "MinimumThreshold": 10
    }
  },
  "ConsumerTopology": {
    "DeadLetterQueue": "gm.otp.dead-letter",
    "Bindings": [
      {
        "Exchange": "gm.events",
        "Kind": "Topic",
        "Queue": "gm.otp.user-confirmation-initiated",
        "RoutingKey": "user.confirmation.initiated"
      },
      {
        "Exchange": "gm.events",
        "Kind": "Topic",
        "Queue": "gm.otp.otp-requested",
        "RoutingKey": "otp.requested"
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
